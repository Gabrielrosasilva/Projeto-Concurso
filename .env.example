# Copie para .env e ajuste. O .env nunca vai para o git.

# Banco. SQLite e o padrao e nao precisa de nada instalado.
# RADAR_DATABASE_URL=sqlite:///data/radar.db
# RADAR_DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar

# Identifique-se ao acessar sites de terceiros. Nao finja ser navegador.
RADAR_USER_AGENT=radar-concursos/0.1 (projeto pessoal de estudo; contato via GitHub)

# Segundos de espera entre duas requisicoes ao MESMO site.
RADAR_REQUEST_DELAY=1.5
RADAR_REQUEST_TIMEOUT=30

# Avisos no Telegram (fase 2). Sem isso preenchido, o radar so nao avisa.
# RADAR_TELEGRAM_TOKEN=
# RADAR_TELEGRAM_CHAT_ID=
