.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
*.egg-info/

# O banco e reconstruivel a partir do export em data/concursos.json
data/*.db

# Acervo pesado: os PDFs NAO vao para o git. O que vai e o manifesto
# data/provas.json, com o sha256 de cada arquivo, e `radar baixar-provas`
# reconstroi a pasta inteira a partir dele.
data/provas/
data/editais/

# O que foi lido do PDF do edital do alvo, guardado para a tela de Meu foco
# nao reabrir o arquivo a cada vez. E cache: some o arquivo e o radar le o
# PDF de novo. Quem tem o sha256 de verdade e o manifesto.
data/edital_do_alvo.json

# Relatorio gerado por ferramentas_gerar_relatorio.py: e artefato, nao fonte.
# Quem quiser o PDF roda o script de novo.
RELATORIO_DO_PROJETO.pdf

# O pedido para a IA e a resposta dela, no caminho sem API (`radar gerar
# --pedido` / `--importar`). Sao de passagem: o que presta vai para
# data/questoes_geradas.json ou data/macetes.json, que sao versionados.
data/pedido_ia.json
data/resposta_ia*.json
